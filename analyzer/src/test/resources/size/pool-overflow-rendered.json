[
 {
  "apiVersion": "v1",
  "kind": "Namespace",
  "metadata": {
   "labels": {
    "app.kubernetes.io/part-of": "flairquery"
   },
   "name": "fq-dev"
  }
 },
 {
  "apiVersion": "v1",
  "kind": "ServiceAccount",
  "metadata": {
   "labels": {
    "app.kubernetes.io/part-of": "flairquery"
   },
   "name": "fq-collector",
   "namespace": "fq-dev"
  }
 },
 {
  "apiVersion": "rbac.authorization.k8s.io/v1",
  "kind": "ClusterRole",
  "metadata": {
   "labels": {
    "app.kubernetes.io/part-of": "flairquery"
   },
   "name": "fq-collector-cadvisor"
  },
  "rules": [
   {
    "apiGroups": [
     ""
    ],
    "resources": [
     "nodes/proxy"
    ],
    "verbs": [
     "get"
    ]
   }
  ]
 },
 {
  "apiVersion": "rbac.authorization.k8s.io/v1",
  "kind": "RoleBinding",
  "metadata": {
   "labels": {
    "app.kubernetes.io/part-of": "flairquery"
   },
   "name": "fq-collector-pods",
   "namespace": "fq-dev"
  },
  "roleRef": {
   "apiGroup": "rbac.authorization.k8s.io",
   "kind": "Role",
   "name": "fq-collector-pods"
  },
  "subjects": [
   {
    "kind": "ServiceAccount",
    "name": "fq-collector",
    "namespace": "fq-dev"
   }
  ]
 },
 {
  "apiVersion": "rbac.authorization.k8s.io/v1",
  "kind": "ClusterRoleBinding",
  "metadata": {
   "labels": {
    "app.kubernetes.io/part-of": "flairquery"
   },
   "name": "fq-collector-cadvisor-fq-dev"
  },
  "roleRef": {
   "apiGroup": "rbac.authorization.k8s.io",
   "kind": "ClusterRole",
   "name": "fq-collector-cadvisor"
  },
  "subjects": [
   {
    "kind": "ServiceAccount",
    "name": "fq-collector",
    "namespace": "fq-dev"
   }
  ]
 },
 {
  "apiVersion": "v1",
  "kind": "PersistentVolumeClaim",
  "metadata": {
   "labels": {
    "app.kubernetes.io/part-of": "flairquery"
   },
   "name": "fq-store-data",
   "namespace": "fq-dev"
  },
  "spec": {
   "accessModes": [
    "ReadWriteOnce"
   ],
   "resources": {
    "requests": {
     "storage": "2Gi"
    }
   }
  }
 },
 {
  "apiVersion": "v1",
  "kind": "PersistentVolumeClaim",
  "metadata": {
   "labels": {
    "app.kubernetes.io/part-of": "flairquery"
   },
   "name": "postgres-data",
   "namespace": "fq-dev"
  },
  "spec": {
   "accessModes": [
    "ReadWriteOnce"
   ],
   "resources": {
    "requests": {
     "storage": "4Gi"
    }
   }
  }
 },
 {
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
   "labels": {
    "app.kubernetes.io/component": "api",
    "app.kubernetes.io/name": "demo-app",
    "app.kubernetes.io/part-of": "flairquery"
   },
   "name": "demo-app",
   "namespace": "fq-dev"
  },
  "spec": {
   "replicas": 3,
   "selector": {
    "matchLabels": {
     "app.kubernetes.io/name": "demo-app"
    }
   },
   "template": {
    "metadata": {
     "annotations": {
      "prometheus.io/path": "/metrics",
      "prometheus.io/port": "9464",
      "prometheus.io/scrape": "true"
     },
     "labels": {
      "app.kubernetes.io/component": "api",
      "app.kubernetes.io/name": "demo-app",
      "app.kubernetes.io/part-of": "flairquery"
     }
    },
    "spec": {
     "containers": [
      {
       "env": [
        {
         "name": "DB_URL",
         "value": "jdbc:postgresql://postgres:5432/flairquery"
        },
        {
         "name": "DB_USER",
         "valueFrom": {
          "secretKeyRef": {
           "key": "POSTGRES_USER",
           "name": "postgres-credentials"
          }
         }
        },
        {
         "name": "DB_PASSWORD",
         "valueFrom": {
          "secretKeyRef": {
           "key": "POSTGRES_PASSWORD",
           "name": "postgres-credentials"
          }
         }
        },
        {
         "name": "HIKARI_MAX_POOL",
         "value": "20"
        },
        {
         "name": "JAVA_TOOL_OPTIONS",
         "value": "-javaagent:/fq/agent.jar -XX:MaxRAMPercentage=80"
        },
        {
         "name": "FQ_ENABLED",
         "value": "true"
        },
        {
         "name": "FQ_APP_NAME",
         "value": "demo-app"
        },
        {
         "name": "FQ_BASE_PACKAGES",
         "value": "io.github.anthonydeseille.flairquery.demo"
        },
        {
         "name": "FQ_NPLUSONE_THRESHOLD",
         "value": "5"
        },
        {
         "name": "FQ_SAMPLING_RATE",
         "value": "1.0"
        },
        {
         "name": "FQ_HTTP_PORT",
         "value": "9464"
        },
        {
         "name": "SPRING_DATASOURCE_HIKARI_REGISTER_MBEANS",
         "value": "true"
        }
       ],
       "image": "flairquery/demo-app:dev",
       "imagePullPolicy": "IfNotPresent",
       "livenessProbe": {
        "httpGet": {
         "path": "/actuator/health/liveness",
         "port": "http"
        },
        "periodSeconds": 10
       },
       "name": "demo-app",
       "ports": [
        {
         "containerPort": 8080,
         "name": "http"
        },
        {
         "containerPort": 9464,
         "name": "fq-metrics"
        }
       ],
       "readinessProbe": {
        "httpGet": {
         "path": "/actuator/health/readiness",
         "port": "http"
        },
        "periodSeconds": 5
       },
       "resources": {
        "limits": {
         "cpu": "500m",
         "memory": "768Mi"
        },
        "requests": {
         "cpu": "25m",
         "memory": "64Mi"
        }
       },
       "startupProbe": {
        "failureThreshold": 60,
        "httpGet": {
         "path": "/actuator/health/liveness",
         "port": "http"
        },
        "periodSeconds": 5
       },
       "volumeMounts": [
        {
         "mountPath": "/fq",
         "name": "fq-agent",
         "readOnly": true
        }
       ]
      }
     ],
     "initContainers": [
      {
       "image": "flairquery/agent:dev",
       "imagePullPolicy": "IfNotPresent",
       "name": "fq-agent",
       "resources": {
        "limits": {
         "cpu": "100m",
         "memory": "32Mi"
        },
        "requests": {
         "cpu": "10m",
         "memory": "16Mi"
        }
       },
       "volumeMounts": [
        {
         "mountPath": "/fq",
         "name": "fq-agent"
        }
       ]
      }
     ],
     "volumes": [
      {
       "emptyDir": {
        "sizeLimit": "32Mi"
       },
       "name": "fq-agent"
      }
     ]
    }
   }
  }
 },
 {
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
   "labels": {
    "app.kubernetes.io/component": "collector",
    "app.kubernetes.io/name": "fq-collector",
    "app.kubernetes.io/part-of": "flairquery"
   },
   "name": "fq-collector",
   "namespace": "fq-dev"
  },
  "spec": {
   "replicas": 1,
   "selector": {
    "matchLabels": {
     "app.kubernetes.io/name": "fq-collector"
    }
   },
   "strategy": {
    "type": "Recreate"
   },
   "template": {
    "metadata": {
     "annotations": {
      "prometheus.io/path": "/metrics",
      "prometheus.io/port": "9465",
      "prometheus.io/scrape": "true"
     },
     "labels": {
      "app.kubernetes.io/component": "collector",
      "app.kubernetes.io/name": "fq-collector",
      "app.kubernetes.io/part-of": "flairquery"
     }
    },
    "spec": {
     "containers": [
      {
       "env": [
        {
         "name": "FQ_COLLECTOR_TARGET_NAME",
         "value": "postgres"
        },
        {
         "name": "FQ_COLLECTOR_TARGET_URL",
         "value": "jdbc:postgresql://postgres:5432/flairquery"
        },
        {
         "name": "FQ_COLLECTOR_TARGET_USER",
         "valueFrom": {
          "secretKeyRef": {
           "key": "PGUSER",
           "name": "fq-reader-credentials"
          }
         }
        },
        {
         "name": "FQ_COLLECTOR_TARGET_PASSWORD",
         "valueFrom": {
          "secretKeyRef": {
           "key": "PGPASSWORD",
           "name": "fq-reader-credentials"
          }
         }
        },
        {
         "name": "FQ_COLLECTOR_STORE_URL",
         "value": "jdbc:postgresql://fq-store:5432/fqstore"
        },
        {
         "name": "FQ_COLLECTOR_STORE_USER",
         "valueFrom": {
          "secretKeyRef": {
           "key": "POSTGRES_USER",
           "name": "fq-store-credentials"
          }
         }
        },
        {
         "name": "FQ_COLLECTOR_STORE_PASSWORD",
         "valueFrom": {
          "secretKeyRef": {
           "key": "POSTGRES_PASSWORD",
           "name": "fq-store-credentials"
          }
         }
        },
        {
         "name": "FQ_COLLECTOR_INTERVAL",
         "value": "30"
        },
        {
         "name": "FQ_COLLECTOR_AGENT_URL",
         "value": "http://demo-app:9464"
        },
        {
         "name": "FQ_COLLECTOR_K8S_SELECTOR",
         "value": "app.kubernetes.io/part-of=flairquery"
        }
       ],
       "image": "flairquery/collector:dev",
       "imagePullPolicy": "IfNotPresent",
       "name": "collector",
       "ports": [
        {
         "containerPort": 9465,
         "name": "http"
        }
       ],
       "readinessProbe": {
        "httpGet": {
         "path": "/fq/collector/health",
         "port": "http"
        },
        "periodSeconds": 5
       },
       "resources": {
        "limits": {
         "cpu": "500m",
         "memory": "256Mi"
        },
        "requests": {
         "cpu": "50m",
         "memory": "224Mi"
        }
       },
       "securityContext": {
        "allowPrivilegeEscalation": false,
        "readOnlyRootFilesystem": true
       },
       "volumeMounts": [
        {
         "mountPath": "/tmp",
         "name": "tmp"
        }
       ]
      }
     ],
     "serviceAccountName": "fq-collector",
     "volumes": [
      {
       "emptyDir": {},
       "name": "tmp"
      }
     ]
    }
   }
  }
 },
 {
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
   "labels": {
    "app.kubernetes.io/component": "collector-store",
    "app.kubernetes.io/name": "fq-store",
    "app.kubernetes.io/part-of": "flairquery"
   },
   "name": "fq-store",
   "namespace": "fq-dev"
  },
  "spec": {
   "replicas": 1,
   "selector": {
    "matchLabels": {
     "app.kubernetes.io/name": "fq-store"
    }
   },
   "strategy": {
    "type": "Recreate"
   },
   "template": {
    "metadata": {
     "labels": {
      "app.kubernetes.io/component": "collector-store",
      "app.kubernetes.io/name": "fq-store",
      "app.kubernetes.io/part-of": "flairquery"
     }
    },
    "spec": {
     "containers": [
      {
       "env": [
        {
         "name": "PGDATA",
         "value": "/var/lib/postgresql/data/pgdata"
        }
       ],
       "envFrom": [
        {
         "secretRef": {
          "name": "fq-store-credentials"
         }
        }
       ],
       "image": "postgres:16",
       "name": "postgres",
       "ports": [
        {
         "containerPort": 5432,
         "name": "postgres"
        }
       ],
       "readinessProbe": {
        "exec": {
         "command": [
          "sh",
          "-c",
          "pg_isready -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\""
         ]
        },
        "periodSeconds": 3
       },
       "resources": {
        "limits": {
         "cpu": "500m",
         "memory": "256Mi"
        },
        "requests": {
         "cpu": "50m",
         "memory": "64Mi"
        }
       },
       "volumeMounts": [
        {
         "mountPath": "/var/lib/postgresql/data",
         "name": "data"
        }
       ]
      }
     ],
     "volumes": [
      {
       "name": "data",
       "persistentVolumeClaim": {
        "claimName": "fq-store-data"
       }
      }
     ]
    }
   }
  }
 },
 {
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
   "labels": {
    "app.kubernetes.io/component": "database",
    "app.kubernetes.io/name": "postgres",
    "app.kubernetes.io/part-of": "flairquery"
   },
   "name": "postgres",
   "namespace": "fq-dev"
  },
  "spec": {
   "replicas": 1,
   "selector": {
    "matchLabels": {
     "app.kubernetes.io/name": "postgres"
    }
   },
   "strategy": {
    "type": "Recreate"
   },
   "template": {
    "metadata": {
     "labels": {
      "app.kubernetes.io/component": "database",
      "app.kubernetes.io/name": "postgres",
      "app.kubernetes.io/part-of": "flairquery"
     }
    },
    "spec": {
     "containers": [
      {
       "args": [
        "-c",
        "config_file=/etc/postgresql/postgresql.conf"
       ],
       "env": [
        {
         "name": "PGDATA",
         "value": "/var/lib/postgresql/data/pgdata"
        }
       ],
       "envFrom": [
        {
         "secretRef": {
          "name": "postgres-credentials"
         }
        }
       ],
       "image": "postgres:16",
       "name": "postgres",
       "ports": [
        {
         "containerPort": 5432,
         "name": "postgres"
        }
       ],
       "readinessProbe": {
        "exec": {
         "command": [
          "sh",
          "-c",
          "pg_isready -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\""
         ]
        },
        "periodSeconds": 3
       },
       "resources": {
        "limits": {
         "cpu": "1",
         "memory": "1Gi"
        },
        "requests": {
         "cpu": "100m",
         "memory": "128Mi"
        }
       },
       "volumeMounts": [
        {
         "mountPath": "/var/lib/postgresql/data",
         "name": "data"
        },
        {
         "mountPath": "/etc/postgresql/postgresql.conf",
         "name": "config",
         "subPath": "postgresql.conf"
        },
        {
         "mountPath": "/docker-entrypoint-initdb.d/10-init-fq.sql",
         "name": "config",
         "subPath": "init-fq.sql"
        }
       ]
      }
     ],
     "volumes": [
      {
       "name": "data",
       "persistentVolumeClaim": {
        "claimName": "postgres-data"
       }
      },
      {
       "configMap": {
        "name": "postgres-config-7c89mbfg49"
       },
       "name": "config"
      }
     ]
    }
   }
  }
 }
]